<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/simple_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/simple_tunes_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/simple_tunes_header" android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp" android:gravity="center_vertical" android:minHeight="0dp" android:paddingStart="14dp" android:text="@string/hyo_search" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_playlist" android:layout_width="136dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/simple_tunes_action" android:drawableStart="@drawable/ic_list" android:drawablePadding="6dp" android:gravity="center" android:minHeight="0dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:singleLine="true" android:text="재생목록" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_gemini" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:background="@drawable/simple_tunes_action" android:minHeight="0dp" android:text="@string/simple_tunes_gemini_playlist" android:textAllCaps="false" android:textColor="#D7CBFF" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <org.schabi.newpipe.views.NewPipeTextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/simple_tunes_genres" android:textColor="#F7F8FF" android:textSize="19sp" android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/update_button" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginEnd="6dp" android:backgroundTint="#35466E" android:minHeight="0dp" android:text="@string/check_for_updates" android:textAllCaps="false" android:textColor="#BFD2FF" android:textSize="12sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_button" android:layout_width="58dp" android:layout_height="32dp" android:backgroundTint="#35466E" android:contentDescription="@string/simple_tunes_theme_button" android:minHeight="0dp" android:text="테마" android:textAllCaps="false" android:textColor="#BFD2FF" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_pop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♫  인기 탐색" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_rock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="ϟ  최신 탐색" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_ballad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♡  장르 탐색" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_jazz" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♬  맞춤 추천" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_classical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♪  즐겨찾기" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_oldies" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="◷  최근 재생" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/recent_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
            <org.schabi.newpipe.views.NewPipeTextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/simple_tunes_recent_title" android:textColor="#F7F8FF" android:textSize="19sp" android:textStyle="bold" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/recent_all" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@android:color/transparent" android:minHeight="0dp" android:text="@string/simple_tunes_view_all" android:textAllCaps="false" android:textColor="#9EB8F8" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/recent_item_1" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="4dp" android:background="@drawable/simple_tunes_action" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
            <ImageView android:id="@+id/recent_thumbnail_1" android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="@string/simple_tunes_thumbnail" android:scaleType="centerCrop" android:src="@drawable/placeholder_thumbnail_video" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_artist_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#AEB8D3" android:textSize="12sp" />
            </LinearLayout>
            <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_equalizer_1" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center" android:text="▂▅▇" android:textColor="#9CC7FF" android:textSize="11sp" android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/recent_play_1" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/play" android:padding="8dp" android:src="@drawable/ic_play_arrow" app:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:id="@+id/recent_item_2" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="4dp" android:background="@drawable/simple_tunes_action" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
            <ImageView android:id="@+id/recent_thumbnail_2" android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="@string/simple_tunes_thumbnail" android:scaleType="centerCrop" android:src="@drawable/placeholder_thumbnail_video" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_artist_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#AEB8D3" android:textSize="12sp" />
            </LinearLayout>
            <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_equalizer_2" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center" android:text="▂▅▇" android:textColor="#9CC7FF" android:textSize="11sp" android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/recent_play_2" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/play" android:padding="8dp" android:src="@drawable/ic_play_arrow" app:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:id="@+id/recent_item_3" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="4dp" android:background="@drawable/simple_tunes_action" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
            <ImageView android:id="@+id/recent_thumbnail_3" android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="@string/simple_tunes_thumbnail" android:scaleType="centerCrop" android:src="@drawable/placeholder_thumbnail_video" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_artist_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#AEB8D3" android:textSize="12sp" />
            </LinearLayout>
            <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/recent_equalizer_3" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center" android:text="▂▅▇" android:textColor="#9CC7FF" android:textSize="11sp" android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/recent_play_3" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/play" android:padding="8dp" android:src="@drawable/ic_play_arrow" app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/quick_playlists_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
            <org.schabi.newpipe.views.NewPipeTextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/simple_tunes_frequent_playlists" android:textColor="#F7F8FF" android:textSize="19sp" android:textStyle="bold" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/playlist_all" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@android:color/transparent" android:minHeight="0dp" android:text="@string/simple_tunes_view_all" android:textAllCaps="false" android:textColor="#9EB8F8" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/quick_playlist_1" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="4dp" android:background="@drawable/simple_tunes_action" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_history" app:tint="#9CC7FF" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/quick_playlist_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simple_tunes_recent_title" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/quick_playlist_subtitle_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simple_tunes_recent_subtitle" android:textColor="#AEB8D3" android:textSize="13sp" />
            </LinearLayout>
            <org.schabi.newpipe.views.NewPipeTextView android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="#9EB8F8" android:textSize="28sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/quick_playlist_2" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="4dp" android:background="@drawable/simple_tunes_action" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
            <androidx.appcompat.widget.AppCompatImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_playlist_play" app:tint="#D4A7FF" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/quick_playlist_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simple_tunes_my_playlists" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/quick_playlist_subtitle_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simple_tunes_playlist_empty" android:textColor="#AEB8D3" android:textSize="13sp" />
            </LinearLayout>
            <org.schabi.newpipe.views.NewPipeTextView android:layout_width="24dp" android:layout_height="wrap_content" android:gravity="center" android:text="›" android:textColor="#9EB8F8" android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
