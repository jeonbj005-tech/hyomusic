<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/simple_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/simple_tunes_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/simple_tunes_header" android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp" android:gravity="center_vertical" android:minHeight="0dp" android:paddingStart="14dp" android:text="@string/hyo_search" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_playlist" android:layout_width="112dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@drawable/simple_tunes_action" android:drawableStart="@drawable/ic_list" android:drawablePadding="6dp" android:gravity="center" android:minHeight="0dp" android:paddingStart="8dp" android:text="재생목록" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_gemini" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/simple_tunes_action" android:minHeight="0dp" android:text="@string/simple_tunes_gemini_playlist" android:textAllCaps="false" android:textColor="#D7CBFF" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <org.schabi.newpipe.views.NewPipeTextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/simple_tunes_genres" android:textColor="#F7F8FF" android:textSize="19sp" android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_button" android:layout_width="58dp" android:layout_height="32dp" android:backgroundTint="#35466E" android:contentDescription="@string/simple_tunes_theme_button" android:minHeight="0dp" android:text="테마" android:textAllCaps="false" android:textColor="#BFD2FF" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_pop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♫  Pop  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_rock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="ϟ  Rock  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_ballad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♡  Ballad  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_jazz" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♬  Jazz  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_classical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♪  Classical  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_oldies" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="◷  Oldies  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
