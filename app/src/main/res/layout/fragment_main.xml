<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/hyo_home_title"
            android:textSize="32sp"
            android:textStyle="bold" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="@string/hyo_home_subtitle"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:minHeight="80dp"
            android:paddingStart="24dp"
            android:text="@string/hyo_search"
            android:textSize="24sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_favorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:drawableStart="@drawable/ic_bookmark"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:minHeight="80dp"
            android:paddingStart="24dp"
            android:text="@string/hyo_favorites"
            android:textSize="24sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_play_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:drawableStart="@drawable/ic_play_arrow"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:minHeight="80dp"
            android:paddingStart="24dp"
            android:text="@string/hyo_play_all"
            android:textSize="24sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:drawableStart="@drawable/ic_history"
            android:drawablePadding="16dp"
            android:gravity="center_vertical"
            android:minHeight="80dp"
            android:paddingStart="24dp"
            android:text="@string/hyo_resume"
            android:textSize="24sp" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hyo_policy_notice"
            android:textSize="14sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
