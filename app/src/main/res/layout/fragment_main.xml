<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/simple_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/simple_tunes_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/simple_tunes_header"
            android:orientation="vertical"
            android:padding="22dp">
        <LinearLayout
            android:id="@+id/simple_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hyo_home_title"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/simple_top_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/hyo_search"
            android:src="@drawable/ic_search" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/simple_top_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
        </LinearLayout>
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="@string/hyo_home_subtitle"
            android:textColor="#E8F7FF"
            android:textSize="18sp" />
        </LinearLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_search"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/simple_tunes_header"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="14dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="@string/hyo_search"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="21sp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_now_playing"
            android:layout_width="match_parent"
            android:layout_height="126dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/simple_tunes_action"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:text="Now playing\nTap to resume your last song"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hyo_favorites"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/simple_tunes_action"
                android:text="@string/hyo_favorites"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hyo_resume"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/simple_tunes_action"
                android:text="@string/hyo_resume_short"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_play_all"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/simple_tunes_action"
            android:text="@string/hyo_play_all"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/simple_tunes_genres"
            android:textColor="#F7F8FF"
            android:textSize="24sp"
            android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_pop" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:text="Pop\n10 songs" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="18sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_rock" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:text="Rock\n10 songs" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_ballad" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:text="Ballad\n10 songs" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="18sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_jazz" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:text="Jazz\n10 songs" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_classical" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:text="Classical\n10 songs" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="18sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_oldies" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:text="Oldies\n10 songs" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="18sp" />
        </LinearLayout>
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/simple_tunes_theme_title"
            android:textColor="#F7F8FF"
            android:textSize="18sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_blue" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:backgroundTint="#4B8DFF" android:text="Blue" android:textAllCaps="false" android:textColor="#FFFFFF" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_purple" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:backgroundTint="#9A52FF" android:text="Purple" android:textAllCaps="false" android:textColor="#FFFFFF" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_green" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:backgroundTint="#20B992" android:text="Green" android:textAllCaps="false" android:textColor="#FFFFFF" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_orange" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="#FF8747" android:text="Orange" android:textAllCaps="false" android:textColor="#FFFFFF" />
        </LinearLayout>
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hyo_policy_notice"
            android:textColor="#A8B0C7"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
