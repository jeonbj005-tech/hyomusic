<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/simple_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/simple_tunes_background"
    android:orientation="vertical"
    android:padding="18dp">
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/simple_tunes_header" android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp" android:gravity="center_vertical" android:minHeight="0dp" android:paddingStart="14dp" android:text="@string/hyo_search" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp" />
    <LinearLayout android:id="@+id/hyo_now_playing" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="12dp" android:background="@drawable/simple_tunes_action" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/simple_recent_lyrics" android:layout_width="104dp" android:layout_height="62dp" android:background="#29365F" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="3" android:padding="8dp" android:text="@string/simple_tunes_lyrics_loading" android:textColor="#C7D5FF" android:textSize="12sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/simple_recent_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="@string/simple_tunes_recent_title" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <org.schabi.newpipe.views.NewPipeTextView android:id="@+id/simple_recent_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:text="@string/simple_tunes_recent_subtitle" android:textColor="#B7C5E8" android:textSize="14sp" />
        </LinearLayout>
        <org.schabi.newpipe.views.NewPipeTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#AFC8FF" android:textSize="28sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_favorites" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/simple_tunes_action" android:minHeight="0dp" android:text="@string/hyo_favorites" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_resume" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/simple_tunes_action" android:minHeight="0dp" android:text="@string/hyo_resume_short" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_play_all" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/simple_tunes_action" android:minHeight="0dp" android:text="@string/hyo_play_all" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <org.schabi.newpipe.views.NewPipeTextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/simple_tunes_genres" android:textColor="#F7F8FF" android:textSize="19sp" android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_button" android:layout_width="44dp" android:layout_height="32dp" android:backgroundTint="#35466E" android:contentDescription="@string/simple_tunes_theme_button" android:minHeight="0dp" android:text="●" android:textAllCaps="false" android:textColor="#BFD2FF" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_pop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♫  Pop  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_rock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="ϟ  Rock  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_ballad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♡  Ballad  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_jazz" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♬  Jazz  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_classical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="♪  Classical  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_oldies" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="◷  Oldies  ·  10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
