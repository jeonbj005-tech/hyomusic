<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hyo_home_title"
            android:textSize="34sp"
            android:textStyle="bold" />
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="@string/hyo_home_subtitle"
            android:textSize="18sp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_search"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="14dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="@string/hyo_search"
            android:textSize="21sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hyo_favorites"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="@string/hyo_favorites"
                android:textSize="17sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/hyo_resume"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/hyo_resume_short"
                android:textSize="17sp" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/hyo_play_all"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:text="@string/hyo_play_all"
            android:textSize="17sp" />
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/simple_tunes_genres"
            android:textSize="24sp"
            android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_pop" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="Pop\n10 songs" android:textSize="18sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_rock" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Rock\n10 songs" android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_ballad" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="Ballad\n10 songs" android:textSize="18sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_jazz" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Jazz\n10 songs" android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_classical" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="Classical\n10 songs" android:textSize="18sp" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_oldies" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Oldies\n10 songs" android:textSize="18sp" />
        </LinearLayout>
        <org.schabi.newpipe.views.NewPipeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hyo_policy_notice"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
