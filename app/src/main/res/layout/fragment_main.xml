<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/simple_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/simple_tunes_background"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:id="@+id/simple_hero" android:layout_width="match_parent" android:layout_height="88dp" android:background="@drawable/simple_tunes_header" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <org.schabi.newpipe.views.NewPipeTextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/hyo_home_title" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/simple_top_search" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/hyo_search" android:src="@drawable/ic_search" />
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/simple_top_settings" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="@string/settings" android:src="@drawable/ic_settings" />
        </LinearLayout>
        <org.schabi.newpipe.views.NewPipeTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hyo_home_subtitle" android:textColor="#E8F7FF" android:textSize="14sp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/simple_tunes_header" android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp" android:gravity="center_vertical" android:minHeight="0dp" android:paddingStart="14dp" android:text="@string/hyo_search" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_now_playing" android:layout_width="match_parent" android:layout_height="74dp" android:layout_marginTop="8dp" android:background="@drawable/simple_tunes_action" android:gravity="center_vertical" android:minHeight="0dp" android:padding="12dp" android:text="Now playing\nTap to resume your last song" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_favorites" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/simple_tunes_action" android:minHeight="0dp" android:text="@string/hyo_favorites" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_resume" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/simple_tunes_action" android:minHeight="0dp" android:text="@string/hyo_resume_short" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_play_all" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:background="@drawable/simple_tunes_action" android:minHeight="0dp" android:text="@string/hyo_play_all" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
    <org.schabi.newpipe.views.NewPipeTextView android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:text="@string/simple_tunes_genres" android:textColor="#F7F8FF" android:textSize="19sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_pop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="Pop · 10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_rock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="Rock · 10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_ballad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="Ballad · 10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_jazz" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="Jazz · 10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_classical" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="Classical · 10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/hyo_oldies" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/simple_tunes_genre" android:minHeight="0dp" android:text="Oldies · 10" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>
    <org.schabi.newpipe.views.NewPipeTextView android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:text="@string/simple_tunes_theme_title" android:textColor="#F7F8FF" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_blue" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:backgroundTint="#4B8DFF" android:minHeight="0dp" android:text="Blue" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_purple" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:backgroundTint="#9A52FF" android:minHeight="0dp" android:text="Purple" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_green" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:backgroundTint="#20B992" android:minHeight="0dp" android:text="Green" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/theme_orange" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="#FF8747" android:minHeight="0dp" android:text="Orange" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
